# Minirt '.rt' file.

# Camera #
# Format : 'C posX,Y,Z dirX,Y,Z fov'
C 0.80,1.13,-0.79 0.15,0.75,0.00 70

# Ambient #
# Format : 'A intensity R,G,B'
A 1 0,0,0


# Skybox #
# Format : 'sky [path.ppm]'
sky (null)

# Materials #
# Format : 'mtl [path.mtl]'
mtl asset/materials/uni/emissive.mtl
mtl asset/materials/uni/reflect.mtl
mtl asset/materials/checkerboard.mtl
mtl asset/materials/uni/mat.mtl
mtl asset/materials/gold.mtl
mtl asset/materials/wood.mtl
mtl asset/materials/marble.mtl

# Primitive #
#  - Sphere format : 'sp posX,Y,Z diameter material_name'
#  - Plane format : 'pl posX,Y,Z normX,Y,Z material_name scaling'
sp 5.00,2.50,1.00 0.50 0,0,0 emissive_white
sp 0.00,0.50,0.00 1.00 0,0,0 mirror
pl 0.00,0.00,0.00 0.00,1.00,0.00 0,0,0 checkerboard 1.00
pl 0.00,10.00,0.00 0.00,-1.00,0.00 0,0,0 checkerboard 1.00
pl 0.50,0.00,2.00 0.00,0.00,-1.00 0,0,0 checkerboard 1.00
pl 0.00,0.00,-5.00 0.00,0.00,1.00 0,0,0 checkerboard 1.00
pl 6.00,0.00,0.00 -1.00,0.00,0.00 0,0,0 checkerboard 1.00
pl -2.00,0.00,0.00 1.00,0.00,0.00 0,0,0 checkerboard 1.00
